{
  "uid": "payrun-payroll-tenancy",
  "title": "PayRun — Payroll & Tenancy",
  "description": "Apakah payroll bulan ini selesai tepat waktu, dan adakah tanda kebocoran antar-tenant atau penyalahgunaan akses?",
  "tags": [
    "payrun"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "INV: tenant isolation violations (24h)",
      "description": "Baris tenant lain lolos ke repository/job (C-46). Normal SELALU 0. Runbook: docs/design/24-observability.md#86-payruninvariantviolated",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(increase(payrun_tenant_isolation_violations_total[24h]))",
          "legendFormat": "count"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
